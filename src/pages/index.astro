---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";

const courses = (await getCollection("courses")).sort((a, b) => a.data.number.localeCompare(b.data.number));
---

<BaseLayout title="YPCA Career Academy | Learn by building" description="Free, self-directed career courses that help you build a stronger resume, standout project, and personal website." socialImage="og.png">
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">YPCA Career Academy</p>
        <h1>Build career assets that are ready to use.</h1>
        <p class="hero-lede">Short, practical courses for early-career professionals. Learn one idea, put it into practice, and leave each course with real work you can use.</p>
        <div class="hero-actions">
          <a class="button primary" href="#courses">Explore courses</a>
          <a class="text-link" href={withBase("events/august-29/")}>View the August 29 event <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-path" aria-label="How courses work">
        <p class="path-kicker">Your learning loop</p>
        <ol>
          <li><span>01</span><div><strong>Learn</strong><small>One clear idea at a time</small></div></li>
          <li><span>02</span><div><strong>Build</strong><small>Apply it to your own career</small></div></li>
          <li><span>03</span><div><strong>Review</strong><small>Check the quality and truth</small></div></li>
          <li><span>04</span><div><strong>Use</strong><small>Leave with a real asset</small></div></li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="course-section" id="courses" aria-labelledby="course-title">
    <div class="shell">
      <div class="section-heading">
        <div><p class="section-kicker">Start where you are</p><h2 id="course-title">Self-directed courses</h2></div>
        <p>Each course includes focused lessons, practical activities, saved progress, reusable prompts, and downloadable resources.</p>
      </div>
      <div class="course-grid">
        {courses.map(({ data }) => (
          <article class={`course-card accent-${data.accent}`} data-course-card={data.slug} data-course-total={data.modules.reduce((total, module) => total + module.lessons.length, 0)}>
            <div class="course-card-top">
              <div class="course-number">Course {data.number}</div>
              <span class="level-pill">{data.level}</span>
              <h3>{data.title}</h3>
              <p>{data.summary}</p>
            </div>
            <div class="course-meta">
              <span><strong>{data.guidedMinutes} min</strong> guided learning</span>
              <span><strong>{data.modules.length * 2} lessons</strong> across {data.modules.length} modules</span>
            </div>
            <ul class="outcome-list">
              {data.outcomes.map((outcome) => <li>{outcome}</li>)}
            </ul>
            <div class="course-progress" hidden data-course-progress>
              <div><span data-progress-label>Not started</span><span data-progress-value>0%</span></div>
              <div class="mini-track"><span data-progress-bar></span></div>
            </div>
            <a class="card-action" href={withBase(`courses/${data.slug}/`)}>
              <span data-course-action>View course</span><span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
      <aside class="upcoming-workshop">
        <div><p>Upcoming one-day event</p><h3>LinkedIn Profile + Networking + Photo Shoot · Saturday, August 29</h3><span>Build a stronger profile, practise purposeful networking, and prepare a professional LinkedIn photo.</span></div>
        <a href={withBase("events/august-29/")}>View event details →</a>
      </aside>
      <div class="community-card-grid">
        <aside class="community-card" aria-labelledby="academy-card-title">
          <div class="community-card-content">
            <p class="community-card-kicker">Keep building after the sprint</p>
            <h3 id="academy-card-title">Interested in more?</h3>
            <p>Explore the YP Career Academy for personalized career assessment, tier-based mentoring, professional connections, and practical guidance to turn your next career move into a clear roadmap.</p>
            <div class="community-features" aria-label="Career Academy highlights">
              <span>Personalized assessment</span>
              <span>One-on-one mentoring</span>
              <span>Career roadmap</span>
            </div>
          </div>
          <a class="community-card-action" href="https://log.youngprofessionalscanada.ca/" target="_blank" rel="noopener">Explore the Career Academy →</a>
        </aside>
        <aside class="community-card ypca-card" aria-labelledby="ypca-card-title">
          <div class="community-card-content">
            <p class="community-card-kicker">Discover the wider YPCA community</p>
            <h3 id="ypca-card-title">Interested in other events?</h3>
            <p>Explore YPCA programs and events designed to help young professionals connect, grow, and contribute—from career development and networking to sports, wellness, leadership, newcomer support, and community service.</p>
            <div class="community-features" aria-label="YPCA program highlights">
              <span>Professional networking</span>
              <span>Sports &amp; wellness</span>
              <span>Leadership &amp; community</span>
            </div>
          </div>
          <a class="community-card-action" href="https://www.youngprofessionalscanada.ca/" target="_blank" rel="noopener">Visit the YPCA website →</a>
        </aside>
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="shell principles-grid">
      <div><p class="section-kicker">Designed for independent learning</p><h2>Guidance when you need it. Action at every step.</h2></div>
      <div class="principle-cards">
        <article><span>01</span><h3>Beginner friendly</h3><p>New terms are explained in plain language before you use them.</p></article>
        <article><span>02</span><h3>Evidence based</h3><p>Your real experience remains the source of truth—especially when using AI.</p></article>
        <article><span>03</span><h3>Built to resume</h3><p>Your completed lessons and next step stay saved in this browser.</p></article>
      </div>
    </div>
  </section>

  <script>
    import { getAllCourseProgress } from "../scripts/progress";
    const cards = [...document.querySelectorAll<HTMLElement>("[data-course-card]")];
    const totals = Object.fromEntries(cards.map((card) => [card.dataset.courseCard || "", Number(card.dataset.courseTotal || 0)]));
    const courseProgress = getAllCourseProgress(totals);
    cards.forEach((card) => {
      const progress = courseProgress[card.dataset.courseCard || ""];
      if (!progress) return;
      const percent = progress.percent;
      const wrap = card.querySelector<HTMLElement>("[data-course-progress]");
      if (!wrap) return;
      wrap.hidden = false;
      const label = wrap.querySelector<HTMLElement>("[data-progress-label]");
      const value = wrap.querySelector<HTMLElement>("[data-progress-value]");
      const bar = wrap.querySelector<HTMLElement>("[data-progress-bar]");
      const action = card.querySelector<HTMLElement>("[data-course-action]");
      if (label) label.textContent = percent === 100 ? "Course complete" : progress.lastVisitedLesson ? "In progress" : "Not started";
      if (value) value.textContent = `${percent}%`;
      if (bar) bar.style.width = `${percent}%`;
      if (action) action.textContent = percent === 100 ? "Review course" : "Continue course";
    });
  </script>
</BaseLayout>
