<BaseLayout title="2026 Sprint Workshops | YPCA Career Academy" description="August 2026 YPCA Career Academy Sprint workshops and self-directed course guides." pageClass="archive-page">
  <section class="archive-hero">
    <div class="shell archive-grid">
      <div>
        <a class="back-link" href={withBase()}>← Current academy</a>
        <p class="eyebrow">Workshop series · August 17–30, 2026</p>
        <h1>Career Academy Sprint</h1>
        <p>Hands-on workshops supported by practical, self-directed course guides you can revisit at any time.</p>
      </div>
      <aside>
        <p>August 2026 workshop schedule</p>
        <div><strong>Saturday, August 22 · 1:00–4:00 PM</strong><span>Resume Building + Tailoring + Project Building</span></div>
        <div><strong>Saturday, August 22 · 4:30–6:30 PM</strong><span>Personal Website Workshop</span></div>
        <div class="featured-schedule"><strong>Saturday, August 29</strong><span>LinkedIn Profile + Networking + Photo Shoot</span><a href={withBase("events/august-29/")}>View August 29 event →</a></div>
      </aside>
    </div>
